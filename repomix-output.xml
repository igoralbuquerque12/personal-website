:root {
  --paper: #f8f9f5;
  --white: #fff;
  --ink: #20251f;
  --muted: #687064;
  --line: #dfe3d9;
  --lime: #c5f366;
  --green: #426128;
  --font-body: var(--font-dm-sans), Arial, sans-serif;
  --font-heading: var(--font-syne), Arial, sans-serif;
  --font-mono: var(--font-dm-mono), monospace;
}
* {
  box-sizing: border-box;
}
html {
  scroll-behavior: smooth;
  scroll-padding-top: 100px;
}
body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font-family: var(--font-body);
  font-size: 15px;
  line-height: 1.65;
  -webkit-font-smoothing: antialiased;
}
button,
input {
  font: inherit;
}
button,
a {
  -webkit-tap-highlight-color: transparent;
}
button {
  cursor: pointer;
  color: inherit;
  border: 0;
}
a {
  color: inherit;
  text-decoration: none;
}
button:focus-visible,
a:focus-visible,
input:focus-visible,
[tabindex]:focus-visible {
  outline: 3px solid #5e8130;
  outline-offset: 5px;
}
h1,
h2,
h3,
h4,
p {
  margin: 0;
}
h1,
h2,
h3,
h4 {
  line-height: 1.17;
}
h1,
h2 {
  font-family: var(--font-heading);
  font-weight: 600;
  letter-spacing: -0.055em;
}
h3,
h4 {
  letter-spacing: -0.035em;
}
svg {
  flex-shrink: 0;
}
::selection {
  background: var(--lime);
  color: var(--ink);
}
.section-shell {
  width: min(1200px, calc(100% - 112px));
  margin-inline: auto;
}
.section-space {
  padding-block: 100px;
}
.mono,
.eyebrow {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.08em;
  font-weight: 400;
}
.eyebrow {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.12em;
}
.eyebrow > span:first-child:not(.status-dot) {
  color: #666e5f;
}
.status-dot {
  display: inline-block;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #709747;
  box-shadow: 0 0 0 4px #70974713;
  flex-shrink: 0;
}
.accent-dot {
  color: #72934c;
}
.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 20px;
  min-height: 48px;
  padding: 12px 22px;
  font-size: 12px;
  font-weight: 600;
  border-radius: 5px;
  transition:
    background 0.2s,
    transform 0.2s;
}
.button:hover {
  transform: translateY(-2px);
}
.button-dark {
  background: var(--ink);
  color: white;
}
.button-dark:hover {
  background: #37452e;
}
.button-outline {
  border: 1px solid #cdd2c6;
  background: transparent;
}
.button-outline:hover {
  background: #eff2e9;
}
.button-lime {
  background: var(--lime);
  color: var(--ink);
}
.button-lime:hover {
  background: #d7ff8e;
}
.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.tags > span {
  font-family: var(--font-mono);
  font-size: 9px;
  line-height: 1.6;
  padding: 4px 8px;
  background: #eef1e9;
  border: 1px solid #e3e7dc;
  border-radius: 4px;
  color: #59604f;
}
.skip-link {
  position: fixed;
  top: -80px;
  left: 20px;
  z-index: 1000;
  padding: 15px;
  background: var(--lime);
}
.skip-link:focus {
  top: 12px;
}
.text-button {
  display: inline-flex;
  gap: 12px;
  align-items: center;
  background: none;
  padding: 8px 0;
  font-weight: 600;
  font-size: 13px;
}
.text-button:hover {
  color: var(--green);
}
@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }
  *,
  *::before,
  *::after {
    animation: none !important;
    transition: none !important;
  }
}
</file>

